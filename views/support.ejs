              <select class="form-control form-select" id="date" name="date">
                <option value="">Please Select Date</option>
                <option value="date1">2027-02-15</option>
                <option value="date2">2027-02-18</option>
                <option value="date3">2027-02-21</option>
              </select>
            </div>

            <div class="hidden col-md-6 mb-3 mb-md-0"  id="concert_date2">
              <label for="date">Date: <span style="color: red;">*</span></label>
              <select class="form-control form-select" id="date" name="date">
                <option value="">Please Select Date</option>
                <option value="date1">2027-3-3</option>
                <option value="date2">2027-3-5</option>
              </select>
            </div>

            <div class="hidden col-md-6 mb-3 mb-md-0"  id="concert_date3">
              <label for="date">Date: <span style="color: red;">*</span></label>
              <select class="form-control form-select" id="date" name="date">
                <option value="">Please Select Date</option>
                <option value="date1">2027-02-15</option>
                <option value="date2">2027-</option>
                <option value="date3">2027-02-21</option>
              </select>
            </div>

            <div class="hidden col-md-6 mb-3 mb-md-0"  id="concert_date4">
              <label for="date">Date: <span style="color: red;">*</span></label>
              <select class="form-control form-select" id="date" name="date">
                <option value="">Please Select Date</option>
                <option value="date1">2027-02-15</option>
                <option value="date2">2027-02-18</option>
                <option value="date3">2027-</option>
              </select>
            </div>
        </div>
      </div>

      <div class="details mb-3">
        <div class="row mb-3">
          <div class="col-md-12 mb-3 mb-md-0">
            <label for="message">Problem faced: <span style="color: red;">*</span></label>
            <textarea class="form-control" id="message" name="message" rows="4" required></textarea>
          </div>
         </div> 
