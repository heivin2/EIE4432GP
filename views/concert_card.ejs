
                <% concerts.forEach(function(concert) { %>
                    <a href="<%= concert.image_url %>" class="concert_card col">
                        <img src="<%= concert.image_url %>" class="w-100 h-75 object-fit-cover border-secondary border rounded "alt="Concert2">
                        <br>
                        <span class="concert-name fw-bold fs-xl"><%= concert.name %></span>
                        <br>
                        <span class="text-secondary fs-sm"><%= concert.location %></span>
                        <br>
                        <span class="text-secondary fs-sm"><%= concert.date %></span>
                        <br>
                        <span class="text-secondary fs-sm"><%= concert.price %></span>
                    </a>
                <% }) %>
